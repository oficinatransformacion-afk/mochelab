{
  "name": "@mochelab/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:maturity-local": "tsc -p tsconfig.seed-local.json && node dist-seed-local/prisma/seed-maturity-models-local.js",
    "db:import:atf-local": "tsc -p tsconfig.seed-local.json && node dist-seed-local/prisma/import-atf-responses-local.js",
    "db:audit:maturity-local": "tsc -p tsconfig.seed-local.json && node dist-seed-local/prisma/audit-maturity-transfer-local.js",
    "db:seed:visualization": "tsx prisma/seed-visualization.ts",
    "db:map:person-structure": "tsc -p tsconfig.seed-local.json && node dist-seed-local/prisma/map-person-structure.js",
    "migration:import": "tsc -p tsconfig.migration.json && node dist-migration/prisma/import-legacy.js"
  },
  "dependencies": {
    "@mochelab/shared": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vitest": "5.0.0"
  }
}
