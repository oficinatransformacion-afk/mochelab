# PostgreSQL (Aiven en producción; una base local también es válida)
DATABASE_URL="postgresql://usuario:clave@host:puerto/mochelab?sslmode=require"
AIVEN_CA_CERT_PATH="certs/aiven-ca.pem"

# API
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
AUTH_SESSION_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"
# Clave exclusiva para el Apps Script que recibe respuestas de Google Forms.
GOOGLE_FORMS_INTEGRATION_KEY="genera-otro-secreto-aleatorio-de-al-menos-32-caracteres"

# Web
VITE_API_URL="http://localhost:3000"
VITE_DEMO_PROFILE="USUARIO"
VITE_APP_ENV="development"

# Gmail API (HTTPS). Mantener desactivado hasta que TI autorice OAuth.
GOOGLE_GMAIL_ENABLED="false"
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REFRESH_TOKEN=""
GOOGLE_GMAIL_SENDER_NAME="Oficina Transformación"
GOOGLE_GMAIL_SENDER_EMAIL="oficinatransformacion@danper.com"

# Alternativa temporal: Google Apps Script como relay de correo.
APPS_SCRIPT_EMAIL_ENABLED="false"
APPS_SCRIPT_EMAIL_WEB_APP_URL=""
APPS_SCRIPT_EMAIL_SECRET=""
APPS_SCRIPT_EMAIL_SENDER_NAME="Oficina Transformación"
COMMUNICATION_AUTO_SEND_ENABLED="false"
COMMUNICATION_AUTO_SEND_HOUR="8"
COMMUNICATION_AUTO_SEND_MINUTE="0"
COMMUNICATION_AUTO_SEND_TIME_ZONE="America/Lima"
COMMUNICATION_AUTO_SEND_BATCH_SIZE="25"
COMMUNICATION_AUTO_SEND_DAILY_MAX="500"
COMMUNICATION_MAX_ATTEMPTS="3"
